// awtm forge portal. PORTAL-SPEC section 4, INTAKE-SPEC section 12 and the
// tables added by CLAUDE.md section 5. Kept in step with docs/DATA-MODEL.md,
// which is updated in the same commit as any migration.
//
// Timestamps are stored UTC and rendered in Asia/Kolkata. Every _paise column
// is BigInt: money is an integer in paise, never a float (ADR 0004).
// Still to come, in the step that owns it: nothing. Every table in
// PORTAL-SPEC section 4 now exists.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  /// Null until the person opens their setup link and chooses one. The script
  /// that creates an account never generates or prints a password.
  passwordHash    String?
  setupTokenHash  String?        @unique
  setupExpiresAt  DateTime?
  setupLinkUsedAt DateTime?
  /// How far down the team's notifications this person has read. Null means
  /// they have never opened the page, so everything counts as new. One
  /// timestamp rather than a row per notification: the activity log is
  /// already the record, and this only marks a place in it (ADR 0020).
  notificationsSeenAt DateTime?
  /// Set when the owner takes this admin's access away (ADR 0024). The row
  /// stays, because uploads and decisions point at it; the password, the
  /// setup link and every session go.
  accessRemovedAt DateTime?
  createdAt       DateTime       @default(now())
  sessions        AdminSession[]
  intakeUploads   Intake[]       @relation("uploadedBy")
  intakeDecisions IntakeChangeRequest[] @relation("decidedChanges")
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())

  @@index([adminUserId])
}

/// The business. Exists on its own, before any project does, so a client can
/// be added on the discovery call and the work decided later.
model Client {
  id           String    @id @default(cuid())
  businessName String
  location     String?
  contactName  String
  contactPhone String
  contactEmail String
  /// The link belongs to the client, not to a project (ADR 0015, QUESTIONS.md
  /// Q12). One link per client, minted when the client is created, and every
  /// project they ever have appears on it. Only the hash is stored.
  accessTokenHash      String    @unique
  /// The same token, encrypted rather than hashed, so the team can send a
  /// client their link again without rotating it and taking away the one they
  /// already have (14 Sep, ADR 0021). The key is derived from SESSION_SECRET,
  /// which is not in the database, so a dump alone reveals nothing. Null on
  /// every row minted before this, which reads as "not in hand" exactly as it
  /// did before.
  accessTokenSealed    String?   @db.VarChar(400)
  tokenCreatedAt       DateTime  @default(now())
  tokenRotatedAt       DateTime?
  linkEmailedAt        DateTime?
  linkEmailError       String?   @db.VarChar(300)
  /// A sign-off person the client typed in the questionnaire. Held here until
  /// a project exists to put them on; the new-project form offers them first.
  proposedSignoffName  String?
  proposedSignoffEmail String?
  proposedAt           DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  intake       Intake?
  sessions     ClientSession[]
  oneTimeCodes OneTimeCode[]
  files        IntakeFile[]
  intakeVersions IntakeVersion[]
  intakeChanges  IntakeChangeRequest[]
  notifications  ClientNotification[]
  documents      ClientDocument[]
}

/// Files a client hands us outside the questionnaire, and files we hand them
/// (ADR 0025). Not evidence: either side can remove one.
model ClientDocument {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  uploadedBy   IntakeParty
  originalName String      @db.VarChar(300)
  mimeType     String
  sizeBytes    Int
  storedPath   String
  thumbPath    String?
  note         String?     @db.VarChar(300)
  createdAt    DateTime    @default(now())

  @@index([clientId])
}

enum TypeOfWork {
  STORE
  APP
  SAAS
  MARKETING
  BRAND
}

model Project {
  id                       String          @id @default(cuid())
  clientId                 String
  client                   Client          @relation(fields: [clientId], references: [id])
  name                     String
  slug                     String          @unique
  typeOfWork               TypeOfWork
  /// Who says yes for this project. On the project rather than the client,
  /// decided by Rahul on 8 Sep 2026: one business can have a different
  /// approver for a brand job than for a store rebuild. This departs from
  /// PORTAL-SPEC section 4, which puts these on client. The two sign-off
  /// codes go to signoffPersonEmail; the login code goes to the client's
  /// contact, because a client can be signed in before any project exists.
  signoffPersonName        String
  signoffPersonEmail       String
  phase                    Phase           @default(INTAKE)
  weekCount                Int?
  metricName               String?
  metricBaselineValue      String?
  metricBaselineCapturedAt DateTime?
  afterDelivery            AfterDelivery   @default(UNDECIDED)
  retainerTier             String?
  retainerNamedPerson      String?
  retainerResponseTime     String?
  handoverDocUrl           String?
  deliveredAt              DateTime?
  /// Set when the client sends or skips the thank-you page, so a decline is
  /// distinguishable from never having got there.
  thanksSeenAt             DateTime?
  /// When Rahul marked the kickoff done, which is when building started.
  /// The needs-attention rule counts silence from here: measuring from the
  /// agreement would blame us for a gap that was theirs.
  kickoffAt                DateTime?
  cancelledAt              DateTime?
  cancelReason             String?         @db.VarChar(500)
  /// The date we have told the client to expect the next thing from us, set by
  /// hand in admin and shown on their home page. Null means we have not said,
  /// and the page then says nothing rather than inventing one.
  ///
  /// Separate from Agreement.launchTargetDate, which is the contractual date
  /// and is frozen the moment the client agrees. This one is about the stage
  /// the project is in now, so transition() clears it on every move: a date
  /// set for the stage that just ended is no longer true of the one that
  /// started, and a stale promise is worse than no promise.
  expectedBy               DateTime?
  /// When the phase last moved. Project has no updatedAt, and the activity log
  /// cannot answer this: emit() swallows its own write failure by design, it
  /// runs after the transaction commits, and several client-visible events
  /// carry no projectId. Written by transition(), which is the one place the
  /// phase changes.
  lastMovedAt              DateTime?
  createdAt                DateTime        @default(now())
  agreement                Agreement?
  agreementNotes           AgreementNote[]
  signoffEvents            SignoffEvent[]
  invoices                 Invoice[]
  activityEvents           ActivityEvent[]
  updates                  Update[]
  reviewRounds             ReviewRound[]
  testimonials             Testimonial[]
  referrals                Referral[]
  day30                    Day30?
  oneTimeCodes             OneTimeCode[]

  @@index([clientId])
}

model ClientSession {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?  @db.VarChar(400)

  @@index([clientId])
}

enum CodePurpose {
  LOGIN
  AGREEMENT
  DELIVERY
}

model OneTimeCode {
  id         String      @id @default(cuid())
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  /// Set for the two sign-off purposes, which belong to a project. A login
  /// code belongs to the client alone.
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id])
  purpose    CodePurpose @default(LOGIN)
  codeHash   String
  sentTo     String
  createdAt  DateTime    @default(now())
  expiresAt  DateTime
  attempts   Int         @default(0)
  consumedAt DateTime?

  @@index([clientId, purpose, createdAt])
  @@index([projectId])
}

model RateLimit {
  key         String   @id @db.VarChar(191)
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model Intake {
  id                   String    @id @default(cuid())
  /// One questionnaire per client, asked once (Q12). Its five sections are
  /// about the business, not about a piece of work.
  clientId             String    @unique
  client               Client    @relation(fields: [clientId], references: [id])
  document             Json
  documentUploadedAt   DateTime  @default(now())
  documentUploadedById String
  documentUploadedBy   AdminUser @relation("uploadedBy", fields: [documentUploadedById], references: [id])
  hiddenQuestionKeys   Json
  sectionsDone         Json      @default("[]")
  answers              Json
  accessGranted        Json
  submittedAt          DateTime?
  lastSavedAt          DateTime?
  overriddenAt         DateTime?
  overriddenById       String?

  @@index([documentUploadedById])
}

model IntakeFile {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  questionKey  String
  storedPath   String
  thumbPath    String?
  originalName String   @db.VarChar(300)
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())

  @@index([clientId, questionKey])
}

/// A snapshot of the answers each time the questionnaire is sent (ADR 0016).
/// Version 1 is the first sending; every later one is the change the client
/// asked for and then sent. Never updated, never deleted: the agreement is
/// written from these, so what was said when has to stay readable.
model IntakeVersion {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  version       Int
  answers       Json
  accessGranted Json
  sentAt        DateTime    @default(now())
  sentBy        IntakeParty

  @@unique([clientId, version])
}

/// Asking to change the questionnaire after it was sent (ADR 0016). The
/// client asks with a line on what needs changing. The team opens it, or
/// declines with a line the client reads. Sending the changes closes it with
/// the version they became. The team can open one without being asked.
model IntakeChangeRequest {
  id          String             @id @default(cuid())
  clientId    String
  client      Client             @relation(fields: [clientId], references: [id])
  status      IntakeChangeStatus @default(ASKED)
  note        String             @db.Text
  askedBy     IntakeParty
  askedAt     DateTime           @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   AdminUser?         @relation("decidedChanges", fields: [decidedById], references: [id])
  reply       String?            @db.Text
  sentAt      DateTime?
  version     Int?

  @@index([clientId, status])
  @@index([decidedById])
}

enum IntakeParty {
  CLIENT
  TEAM
}

enum IntakeChangeStatus {
  ASKED
  OPEN
  DECLINED
  SENT
}

/// What the client is told (Q19): a record of the moments that concern them,
/// shown in the portal with an unread mark and, for the ones that ask them to
/// look or act, emailed too. Written by the notifications subscriber from
/// activity events, so it never carries an internal amount.
model ClientNotification {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  kind      String
  title     String    @db.VarChar(300)
  body      String    @db.Text
  path      String    @db.VarChar(120)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([clientId, createdAt])
}

model ImageLibrary {
  id         String   @id @default(cuid())
  key        String   @unique
  storedPath String
  mimeType   String
  caption    String
  uploadedAt DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  business  String
  problem   String   @db.Text
  budget    String
  adSpend   String
  contact   String
  createdAt DateTime @default(now())
}

enum Phase {
  INTAKE
  AGREEMENT_DRAFT
  AGREEMENT_SENT
  AGREED
  BUILDING
  IN_REVIEW
  DELIVERED
  CLOSED
  CANCELLED
}

enum AfterDelivery {
  RETAINER
  HANDOVER
  UNDECIDED
}

/// Singleton. The team's own details, on every invoice and agreement.
model Company {
  id                String   @id @default("company")
  name              String
  address           String   @db.Text
  email             String
  phone             String
  logoUrl           String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  invoicePrefix     String   @default("AWTM")
  /// Null until registered. PORTAL-SPEC 5.8: no tax line while this is null.
  gstin             String?
  bookingUrl        String?
  defaultAdvancePct Int      @default(50)
  updatedAt         DateTime @updatedAt
}

/// Typed key-value. A new setting is a key with a default, not a migration.
model Setting {
  key       String   @id @db.VarChar(191)
  value     String   @db.Text
  type      String   @db.VarChar(16)
  updatedAt DateTime @updatedAt
}

/// One per project. Read-only forever once agreedAt is set (PORTAL-SPEC 5.4).
model Agreement {
  id                 String         @id @default(cuid())
  projectId          String         @unique
  project            Project        @relation(fields: [projectId], references: [id])
  scope              String         @db.Text
  /// [{ key, text, how_to_check }]. The review checks against these.
  deliverables       Json
  notIncluded        String         @db.Text
  startDate          DateTime?
  launchTargetDate   DateTime?
  /// [{ label, date }]. Shown as dates, never as sign-offs.
  milestones         Json
  totalPaise         BigInt         @default(0)
  advancePct         Int
  howWeWork          String         @db.Text
  ifWeMiss           String         @db.Text
  afterDeliveryOffer String         @db.Text
  /// ADMIN ONLY. Never on a client route, print route, export or template.
  internalCostPaise  BigInt         @default(0)
  /// ADMIN ONLY.
  internalNotes      String         @db.Text
  sentAt             DateTime?
  agreedAt           DateTime?
  agreedByName       String?
  agreedMethod       SignoffMethod?
  version            Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

/// Append-only. The client saying something is off, CLAUDE.md 5.1.
model AgreementNote {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  agreementVersion Int
  text             String   @db.Text
  enteredBy        String   @db.VarChar(16)
  createdAt        DateTime @default(now())

  @@index([projectId, createdAt])
}

enum SignoffKind {
  AGREEMENT
  DELIVERY
}

enum SignoffMethod {
  PORTAL
  WHATSAPP
}

/// Append-only legal evidence. No update path, no delete path, no cascade.
model SignoffEvent {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id])
  kind             SignoffKind
  occurredAt       DateTime      @default(now())
  method           SignoffMethod
  actorName        String
  ip               String?       @db.VarChar(64)
  userAgent        String?       @db.VarChar(400)
  /// For whatsapp: the pasted message.
  rawNote          String?       @db.Text
  agreementVersion Int?

  @@index([projectId, kind])
}

enum InvoiceKind {
  ADVANCE
  BALANCE
  OTHER
}

enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id])
  kind           InvoiceKind
  number         String        @unique
  issuedAt       DateTime      @default(now())
  description    String        @db.VarChar(300)
  amountPaise    BigInt
  taxAmountPaise BigInt        @default(0)
  totalPaise     BigInt
  status         InvoiceStatus @default(ISSUED)
  paidAt         DateTime?
  paidReference  String?
  paymentMethod  String?

  @@index([projectId, kind])
}

/// One row per prefix and financial year. Locked FOR UPDATE inside the
/// transaction that issues an invoice. lastSeq only ever rises by one.
model InvoiceSequence {
  prefix  String @db.VarChar(16)
  fy      String @db.VarChar(8)
  lastSeq Int    @default(0)

  @@id([prefix, fy])
}

/// The weekly written update. A draft until sentAt is set; after that it has
/// been read by the client and the module refuses to change it.
model Update {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  weekNumber  Int
  moved       String    @db.Text
  nextUp      String    @db.Text
  needFromYou String    @db.Text
  needByDate  DateTime?
  risks       String    @db.Text
  stagingUrl  String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, weekNumber])
  @@index([projectId, sentAt])
}

enum ReviewOutcome {
  OPEN
  CHANGES_REQUESTED
  ACCEPTED
}

/// One round of the review loop (PORTAL-SPEC 5.5). Rounds are unlimited and
/// every one is kept: no delete path exists. A round is written to once after
/// creation, when the client answers, and is finished from then on.
model ReviewRound {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  roundNumber     Int
  sentAt          DateTime      @default(now())
  /// Where the client can see the finished work: a live site, a staging link
  /// or a folder. Required, because a review only happens when the work is
  /// complete, so there is always something to look at.
  finishedWorkUrl String        @db.VarChar(500)
  clientNote      String?       @db.Text
  respondedAt     DateTime?
  outcome         ReviewOutcome @default(OPEN)

  @@unique([projectId, roundNumber])
  @@index([projectId, sentAt])
}

enum TestimonialMoment {
  DELIVERY
  DAY30
}

enum TestimonialStatus {
  DRAFT
  APPROVED
}

/// The client's own words. Drafted at delivery, approved at day 30. Only an
/// approved one may appear anywhere outside admin (CLAUDE.md 5.1).
model Testimonial {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id])
  moment         TestimonialMoment
  text           String            @db.Text
  /// Asked at day 30, not at delivery, so both start false.
  useName        Boolean           @default(false)
  useLogo        Boolean           @default(false)
  status         TestimonialStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  approvedAt     DateTime?
  approvedMethod SignoffMethod?

  @@unique([projectId, moment])
}

/// Someone the client named. This holds a third party's details and that
/// person never consented to being stored, so unlike every other record here
/// admin can delete it. It is shown only in admin, never on a client route,
/// in an export or in a WhatsApp message.
model Referral {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  contact   String
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Created by the delivery sign-off, thirty days out. Step 10 fills it.
model Day30 {
  id                     String    @id @default(cuid())
  projectId              String    @unique
  project                Project   @relation(fields: [projectId], references: [id])
  unlocksAt              DateTime
  openedAt               DateTime?
  metricAfterValue       String?
  metricAfterSubmittedAt DateTime?
  /// ADMIN ONLY.
  frictionNotes          String    @db.Text

  @@index([unlocksAt])
}

/// Append-only. Every meaningful change. Payload passes through the client
/// serializer before it is written, so internal cost cannot reach the log.
model ActivityEvent {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  type      String   @db.VarChar(64)
  payload   Json
  actor     String   @db.VarChar(120)
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([type, createdAt])
}
