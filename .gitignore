# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# Generated by prisma generate on every install and build. Regenerated, never
# reviewed, and large: it does not belong in a diff.
/src/generated/

# Environment. Names and meanings live in .env.example, which IS committed;
# real values live in .env locally and in the Hostinger panel in production.
# CLAUDE.md section 2 rule 4: no live credential of ours in the repo, ever.
.env
.env.*
!.env.example

# Local development data. Uploads written under UPLOAD_DIR when it points
# inside the repo, and anything else the running app writes.
/.data/

# Test output. Reports and traces are artefacts of a run, and traces can
# contain a screenshot of a page mid-journey.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Editor and machine noise. .claude/launch.json is committed on purpose: it is
# how the dev server starts. Anything .local is one person's own setting.
.claude/*.local.json
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets and keys, in any form, anywhere in the tree
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Deployment
/.vercel
