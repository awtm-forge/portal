# Names and meanings only. Real values live in .env locally (gitignored) and in
# the Hostinger panel in production. Never commit a live value. See DEPLOY.md.

# MySQL connection. The docker-compose database is the line below verbatim.
DATABASE_URL="mysql://awtm:awtmdev@127.0.0.1:3307/awtm"
# Signs session cookies and keys the one-time code hashes. Any long random string.
SESSION_SECRET=""
# Absolute path to the upload store, outside the web root and outside the repo.
UPLOAD_DIR=""
# Where the client portal answers, used to build every client link. Absolute
# http or https URL, no trailing slash. A value without a scheme is ignored.
APP_URL="http://localhost:3200"
# Where the team admin answers, when it has its own hostname (ADR 0013). Leave
# it empty to run both on APP_URL, which is what development and the tests do.
# When it is set and differs, each host answers for its own zone only: the
# client host has no /admin and the team host has no /p/.
ADMIN_URL=""
# Only used before the first admin account exists. When there is none, and
# only then, /admin/first-run asks for this value and makes that one account
# (ADR 0014). It exists because some hosts give you no way to run a script
# beside the app. Any long random string. Delete it once you are in.
SETUP_KEY=""
# SMTP for the one-time code, the link email and team notifications, nothing else.
# Leave SMTP_HOST empty in development: the mailer writes to the server log instead.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# The From address on every outgoing message.
SMTP_FROM="awtm forge <hello@awtmforge.com>"
# Where team notifications go: intake submitted, agreed, changes requested,
# delivered, day 30 approved, and every enquiry from the site.
TEAM_NOTIFY_EMAIL=""
# The owner of the admin: the one account that adds admins, reissues their
# setup links and takes access away (ADR 0024). Their sign-in address. While
# this is empty every admin can do those things, which is how two founders
# started. There is no limit on how many admins the owner adds.
OWNER_EMAIL=""
# WhatsApp for the team's notifications (ADR 0026): every notice the bell and
# the email carry, sent to the team's own number through the WhatsApp Business
# Cloud API. Off while any of the first three is empty. DEPLOY.md has the setup.
# The permanent access token of a system user on the WhatsApp Business account.
WHATSAPP_TOKEN=""
# The id of the sending phone number, from the WhatsApp Manager, not the number itself.
WHATSAPP_PHONE_NUMBER_ID=""
# The team's number, digits with the country code and nothing else, e.g. 919876543210.
TEAM_WHATSAPP_TO=""
# The approved template's name and language. These are the defaults.
WHATSAPP_TEMPLATE="awtm_client_activity"
WHATSAPP_TEMPLATE_LANG="en"
# All dates, the financial year boundary and invoice dates are computed here.
TZ="Asia/Kolkata"
# Set to "log" to write mail to the server log instead of sending it.
# Development does this by default when SMTP_HOST is empty; the end to end
# tests set it explicitly. Never set it in production.
MAIL_TRANSPORT=""
